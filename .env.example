# Browser-safe Supabase configuration
# The publishable key is designed to be public. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: URL of the Express backend used by the integration routes.
# Leave empty for the default Supabase Edge Function path.
VITE_API_URL=

# Server configuration for the optional Express API
CLIENT_URL=http://localhost:8080
PORT=8787
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/integrations/github/callback
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
